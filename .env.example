# ============================================================================
# Copie para .env (local) ou cadastre como variáveis do projeto (produção).
#
# `npm run build` roda `scripts/check-env.mjs` antes de compilar: em produção
# ele DERRUBA o deploy se algum segredo ainda for o de exemplo, se o banco
# estiver sem SSL ou se uma integração estiver ligada pela metade.
# Para conferir na mão: npm run check:env
# ============================================================================

# ---------- Banco ----------
DATABASE_URL=postgresql://user:senha@host:5432/agenda?sslmode=require
DATABASE_SSL=true

# ---------- Auth ----------
# GERE UM NOVO. O valor abaixo é público — quem lê o repositório assina o
# próprio token de acesso e entra como dono de qualquer empresa.
#   openssl rand -base64 48
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-de-48-bytes
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

# ---------- App ----------
# Em produção precisa ser https: é a URL que vai no link enviado ao cliente.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=America/Sao_Paulo

# ---------- Jobs / Cron ----------
# Sem isto o worker recusa tudo e nenhum lembrete é enviado.
# Precisa ser DIFERENTE do JWT_SECRET.  openssl rand -base64 32
# O Vercel Cron manda sozinho como `Authorization: Bearer`.
CRON_SECRET=troque-este-segredo

# ---------- WhatsApp (Bot-Whats existente) ----------
# WHATSAPP_TOKEN também autentica o bot em /api/v1/ai/chat.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=http://localhost:3001
WHATSAPP_TOKEN=

# ---------- Pagamentos ----------
# provider: manual | mercadopago
# `manual` = pagamento no balcão (maquininha), registrado à mão. É o correto
# enquanto não houver cobrança online.
PAYMENT_PROVIDER=manual
MERCADOPAGO_ACCESS_TOKEN=
# Sem o segredo do webhook, qualquer um pode avisar que um pagamento foi aprovado.
MERCADOPAGO_WEBHOOK_SECRET=

# ---------- IA (opcional, atendimento WhatsApp) ----------
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ---------- Rate limit ----------
# Contador compartilhado entre as instâncias. SEM isto o limite ainda funciona,
# mas cada instância conta sozinha — com 4 instâncias, o teto de 5 tentativas de
# login vira 20. A integração Upstash da Vercel preenche estas duas variáveis
# sozinha (em projetos antigos ela usa KV_REST_API_URL/KV_REST_API_TOKEN, que o
# código também aceita).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fator multiplicador dos limites (1 = padrão de produção)
RATE_LIMIT_FACTOR=1
# Desliga o limite. Ignorado quando NODE_ENV=production, e o check-env recusa
# o deploy se estiver `true` — só existe para a suíte de testes.
# RATE_LIMIT_DISABLED=false
