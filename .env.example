# ---------- Banco ----------
DATABASE_URL=postgresql://user:senha@host:5432/agenda?sslmode=require
DATABASE_SSL=true

# ---------- Auth ----------
# openssl rand -base64 48
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-de-48-bytes
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30

# ---------- App ----------
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=America/Sao_Paulo

# ---------- Jobs / Cron ----------
CRON_SECRET=troque-este-segredo

# ---------- WhatsApp (Bot-Whats existente) ----------
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=http://localhost:3001
WHATSAPP_TOKEN=

# ---------- Pagamentos ----------
# provider: manual | mercadopago
PAYMENT_PROVIDER=manual
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------- IA (opcional, atendimento WhatsApp) ----------
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ---------- Rate limit ----------
# Fator multiplicador dos limites (1 = padrao de producao)
RATE_LIMIT_FACTOR=1
# Desliga o limite. Ignorado quando NODE_ENV=production.
# RATE_LIMIT_DISABLED=false
