# Modelo do `.env` da VPS. Copie para `.env` NA VPS e preencha la.
# Este arquivo e' so a lista -- nenhum valor real entra no repositorio.

# ---------------------------------------------------------------- banco
# Banco do projeto Supabase "Duda machado". Use um usuario proprio, restrito
# ao schema `barbearia`; a senha do `postgres` serve apenas para migrations.
#
# NAO acrescente `sslmode=require`: o `pg` monta a propria configuracao de TLS
# a partir do parametro e passa a verificar a cadeia, o que quebra com
# SELF_SIGNED_CERT_IN_CHAIN contra o pooler do Supabase. O caminho e'
# `DATABASE_SSL=true`, que e' o que o `db.ts` le para ligar a conexao cifrada.
DATABASE_URL=postgresql://barbearia_app:SENHA@db.nfkttvilzoyfczxmbdpd.supabase.co:5432/postgres
DATABASE_SSL=true

# Na VPS, prefira a conexao direta acima. Ela usa IPv6. Se a VPS nao tiver
# IPv6, abra Connect -> Session pooler no Supabase e substitua a URL inteira
# pela URI exibida ali. Codifique caracteres especiais da senha na URL.

# O sistema nao mora no `public`: o mesmo projeto Supabase hospeda os
# restaurantes da casa, e `clients`, `payments` e `products` se repetem em
# todos. Sem esta variavel a aplicacao procura as tabelas no lugar errado.
DB_SCHEMA=barbearia

# ---------------------------------------------------------------- segredos
# Gere cada um com: openssl rand -base64 48
# Os dois precisam ser DIFERENTES -- vazar um nao pode entregar o outro.
JWT_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------- app
APP_URL=https://dlzbarbearia.com.br
NEXT_PUBLIC_APP_URL=https://dlzbarbearia.com.br

# ---------------------------------------------------------------- whatsapp
# O bot Baileys ja existente. A sessao desta instalacao nasce com o prefixo
# `barb-`, que e' o que a impede de alcancar a sessao dos outros sistemas.
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=
WHATSAPP_TOKEN=

# ---------------------------------------------------------------- pagamento
# `manual` = pagamento no balcao, que e' o caso de todas as lojas hoje. O
# gateway de verdade e' por loja (`business_settings.payment_provider`), nao
# por deploy -- esta variavel so diz quais credenciais ESTE deploy tem.
PAYMENT_PROVIDER=pagarme
PAGARME_SECRET_KEY=
# Gere um valor aleatorio. No painel Pagar.me, cadastre exatamente:
# https://dlzbarbearia.com.br/api/v1/payments/webhook/pagarme?token=ESTE_VALOR
PAGARME_WEBHOOK_TOKEN=
PAGARME_BASE_URL=https://api.pagar.me/core/v5
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------- opcional
# Sem Redis o rate limit conta por instancia. Com uma instancia so, como aqui,
# o numero escrito e' o numero real -- passa a importar no dia que escalar.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
